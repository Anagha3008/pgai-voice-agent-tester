# OpenAI Realtime API key with access to gpt-realtime-2.1
OPENAI_API_KEY=

# Twilio credentials from https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Your Twilio phone number in E.164 format (example: +15551234567)
# Use this same number in the PGAI submission form.
TWILIO_PHONE_NUMBER=

# Public HTTPS URL from ngrok or Cloudflare Tunnel (no trailing slash)
# Example: https://abc123.ngrok-free.app
PUBLIC_BASE_URL=
